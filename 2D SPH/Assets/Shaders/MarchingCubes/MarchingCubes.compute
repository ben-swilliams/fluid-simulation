#pragma kernel ProcessCube

// Offset into the look up table where the indices for each of the 256 cube configurations are stored
static const int offsets[256] = {0, 0, 3, 6, 12, 15, 21, 27, 36, 39, 45, 51, 60, 66, 75, 84, 90, 93, 99, 105, 114, 120, 129, 138, 150, 156, 165, 174, 186, 195, 207, 219, 228, 231, 237, 243, 252, 258, 267, 276, 288, 294, 303, 312, 324, 333, 345, 357, 366, 372, 381, 390, 396, 405, 417, 429, 438, 447, 459, 471, 480, 492, 507, 522, 528, 531, 537, 543, 552, 558, 567, 576, 588, 594, 603, 612, 624, 633, 645, 657, 666, 672, 681, 690, 702, 711, 723, 735, 750, 759, 771, 783, 798, 810, 825, 840, 852, 858, 867, 876, 888, 897, 909, 915, 924, 933, 945, 957, 972, 984, 999, 1008, 1014, 1023, 1035, 1047, 1056, 1068, 1083, 1092, 1098, 1110, 1125, 1140, 1152, 1167, 1173, 1185, 1188, 1191, 1197, 1203, 1212, 1218, 1227, 1236, 1248, 1254, 1263, 1272, 1284, 1293, 1305, 1317, 1326, 1332, 1341, 1350, 1362, 1371, 1383, 1395, 1410, 1419, 1425, 1437, 1446, 1458, 1467, 1482, 1488, 1494, 1503, 1512, 1524, 1533, 1545, 1557, 1572, 1581, 1593, 1605, 1620, 1632, 1647, 1662, 1674, 1683, 1695, 1707, 1716, 1728, 1743, 1758, 1770, 1782, 1791, 1806, 1812, 1827, 1839, 1845, 1848, 1854, 1863, 1872, 1884, 1893, 1905, 1917, 1932, 1941, 1953, 1965, 1980, 1986, 1995, 2004, 2010, 2019, 2031, 2043, 2058, 2070, 2085, 2100, 2106, 2118, 2127, 2142, 2154, 2163, 2169, 2181, 2184, 2193, 2205, 2217, 2232, 2244, 2259, 2268, 2280, 2292, 2307, 2322, 2328, 2337, 2349, 2355, 2358, 2364, 2373, 2382, 2388, 2397, 2409, 2415, 2418, 2427, 2433, 2445, 2448, 2454, 2457, 2460};
// The number of indices (3 per triangle) for each of the 256 cube configurations
static const int lengths[256] = {0, 3, 3, 6, 3, 6, 6, 9, 3, 6, 6, 9, 6, 9, 9, 6, 3, 6, 6, 9, 6, 9, 9, 12, 6, 9, 9, 12, 9, 12, 12, 9, 3, 6, 6, 9, 6, 9, 9, 12, 6, 9, 9, 12, 9, 12, 12, 9, 6, 9, 9, 6, 9, 12, 12, 9, 9, 12, 12, 9, 12, 15, 15, 6, 3, 6, 6, 9, 6, 9, 9, 12, 6, 9, 9, 12, 9, 12, 12, 9, 6, 9, 9, 12, 9, 12, 12, 15, 9, 12, 12, 15, 12, 15, 15, 12, 6, 9, 9, 12, 9, 12, 6, 9, 9, 12, 12, 15, 12, 15, 9, 6, 9, 12, 12, 9, 12, 15, 9, 6, 12, 15, 15, 12, 15, 6, 12, 3, 3, 6, 6, 9, 6, 9, 9, 12, 6, 9, 9, 12, 9, 12, 12, 9, 6, 9, 9, 12, 9, 12, 12, 15, 9, 6, 12, 9, 12, 9, 15, 6, 6, 9, 9, 12, 9, 12, 12, 15, 9, 12, 12, 15, 12, 15, 15, 12, 9, 12, 12, 9, 12, 15, 15, 12, 12, 9, 15, 6, 15, 12, 6, 3, 6, 9, 9, 12, 9, 12, 12, 15, 9, 12, 12, 15, 6, 9, 9, 6, 9, 12, 12, 15, 12, 15, 15, 6, 12, 9, 15, 12, 9, 6, 12, 3, 9, 12, 12, 15, 12, 15, 9, 12, 12, 15, 15, 6, 9, 12, 6, 3, 6, 9, 9, 6, 9, 12, 6, 3, 9, 6, 12, 3, 6, 3, 3, 0};

// Indices for edge 3 are listA[3] and listB[3]
static const int cornerIndexAFromEdge[12] = {0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3};
static const int cornerIndexBFromEdge[12] = {1, 2, 3, 0, 5, 6, 7, 4, 4, 5, 6, 7};

struct Vertex {
	float3 position;
	float3 normal;
};

struct Triangle {
	Vertex a;
	Vertex b;
	Vertex c;
};

Texture3D<float> DensityTex;
SamplerState linearClampSampler;

int3 densityTexDims;

float3 containerSize;

float isoLevel;

RWStructuredBuffer<int> LUT;
AppendStructuredBuffer<Triangle> Triangles;

int FlattenedIndex(int3 idx) {
    return idx.x + idx.y * densityTexDims.x + idx.z * densityTexDims.x * densityTexDims.y;
}

float3 VoxelToWorld(int3 voxelCoord) {
    float3 normCoord = (voxelCoord / (densityTexDims - 1.0)) - 0.5;
    return normCoord * containerSize;
}

float SampleDensityTexture(uint3 voxelCoord)
{
	bool isEdge = any(voxelCoord <= 0 || voxelCoord >= densityTexDims - 1);
	if (isEdge) return isoLevel;

	float3 uvw = voxelCoord / (float3) (densityTexDims - 1);
	return -DensityTex.SampleLevel(linearClampSampler, uvw, 0);
}

float3 CalculateNormal(int3 corner) {
    int3 offsetX = int3(1, 0, 0);
    int3 offsetY = int3(0, 1, 0);
    int3 offsetZ = int3(0, 0, 1);

    float dx = SampleDensityTexture(corner + offsetX) - SampleDensityTexture(corner - offsetX);
    float dy = SampleDensityTexture(corner + offsetY) - SampleDensityTexture(corner - offsetY);
    float dz = SampleDensityTexture(corner + offsetZ) - SampleDensityTexture(corner - offsetZ);

    return normalize(float3(dx, dy, dz));
}

Vertex CreateVertex(int3 cornerA, int3 cornerB) {
    // We just need to find where along this edge the density would equal isoLevel

    float3 posA = VoxelToWorld(cornerA);
    float3 posB = VoxelToWorld(cornerB);

    float densityA = SampleDensityTexture(cornerA);
    float densityB = SampleDensityTexture(cornerB);

    // Isolevel is t along the edge (0-1)
    float t = (isoLevel - densityA) / (densityB - densityA);
    float3 pos = posA + t * (posB - posA);

    float3 normalA = CalculateNormal(cornerA);
    float3 normalB = CalculateNormal(cornerB);
    float3 normal = normalize(normalA + t * (normalB - normalA));

    Vertex v;
    v.position = pos;
    v.normal = normal;

    return v;
}

[numthreads(8, 8, 8)]
void ProcessCube(uint3 id : SV_DispatchThreadID) {
    int3 cubesPerAxis = densityTexDims - 1;
    if (id.x >= cubesPerAxis.x || id.y >= cubesPerAxis.y || id.z >= cubesPerAxis.z) return;

    int3 cornerIndices[8];
    cornerIndices[0] = id + int3(0, 0, 0);
    cornerIndices[1] = id + int3(1, 0, 0);
    cornerIndices[2] = id + int3(1, 0, 1);
    cornerIndices[3] = id + int3(0, 0, 1);
    cornerIndices[4] = id + int3(0, 1, 0);
    cornerIndices[5] = id + int3(1, 1, 0);
    cornerIndices[6] = id + int3(1, 1, 1);
    cornerIndices[7] = id + int3(0, 1, 1);

    // There are 2^8 configurations for each of the 8 cube corners being inside/outside liquid
    // Which configuration to use is given by the LUT, which we index into by setting each bit 
    // of an integer according to whether it is inside/outside

    // Credit to SL for his lookup table/indexing method
    int cubeConfig = 0;
    for (uint i = 0; i < 8; i++) {
        if (SampleDensityTexture(cornerIndices[i]) < isoLevel) {
            cubeConfig |= (1 << i);
        }
    }

    // How many indices needed for this cube, and where to find
    // the edges in the LUT
    int numIndices = lengths[cubeConfig];
    int offset = offsets[cubeConfig];

    for (int i = 0; i < numIndices; i += 3) {
        
        // For this triangle, it's three vertices lie somewhere on these 3 edges
        int edgeA = LUT[offset + i];
        int edgeB = LUT[offset + i + 1];
        int edgeC = LUT[offset + i + 2];

        // The ends of each of three relevant edges
        int a0 = cornerIndexAFromEdge[edgeA];
        int a1 = cornerIndexBFromEdge[edgeA];
        int b0 = cornerIndexAFromEdge[edgeB];
        int b1 = cornerIndexBFromEdge[edgeB];
        int c0 = cornerIndexAFromEdge[edgeC];
        int c1 = cornerIndexBFromEdge[edgeC];

        Vertex v0 = CreateVertex(cornerIndices[a0], cornerIndices[a1]);
        Vertex v1 = CreateVertex(cornerIndices[b0], cornerIndices[b1]);
        Vertex v2 = CreateVertex(cornerIndices[c0], cornerIndices[c1]);

        Triangle tri;
        tri.a = v0;
        tri.b = v1;
        tri.c = v2;

        Triangles.Append(tri);
    }
}