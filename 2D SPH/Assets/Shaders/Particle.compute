#pragma kernel ZeroCounts
#pragma kernel Partition
#pragma kernel Scan
#pragma kernel ScanBlockSums
#pragma kernel AddBlockSums
#pragma kernel FinalizeScan
#pragma kernel Scatter
#pragma kernel IntermediateAcceleration
#pragma kernel Density

#pragma kernel UpdateVelocities
#pragma kernel UpdatePositions

/*
Global parameters
*/

static const uint NumThreads = 64;

// Integer buffers
RWStructuredBuffer<uint> CellCounts;
RWStructuredBuffer<uint> Offsets;
RWStructuredBuffer<uint> LocalOffsets;

// Float buffers
RWStructuredBuffer<float> Densities;
RWStructuredBuffer<float> NearDensities;

// Vector buffers
RWStructuredBuffer<float2> Positions;
RWStructuredBuffer<float2> Velocities;

RWStructuredBuffer<float2> IntermediateAccelerations;

// Integers
uint instanceCount;

// Floats
float deltaTime;
float particleMass;
float smoothingRadius;

// Vectors
float2 containerSize;

/*
External force parameters
*/
// Floats
float size;
float dampingFactor;
float power;
float mouseRadius;
float speedOfSound;

// Vectors
float2 mousePos;
float2 gravity;

/*
Scan/partition parameters
*/
// Integers
uint gridX;
uint gridY;
uint tableSize;
uint numBlockSums;

#include "Kernels.hlsl"
#include "Partition.hlsl"
#include "Scan.hlsl"
#include "Scatter.hlsl"
#include "External.hlsl"
#include "Density.hlsl"
#include "Pressure.hlsl"
#include "Viscosity.hlsl"
#include "SurfaceTension.hlsl"
#include "XSPH.hlsl"

void CalculateComponents(uint i, out float2 viscosity, out float2 surfaceTension) {
    int2 gridPosI = GetGridPos(Positions[i]);

    for (int x = -1; x < 2; x++) {
        for (int y = -1; y < 2; y++) {
            int2 gridPosJ = gridPosI + int2(x, y);
            if (!IsInBounds(gridPosJ)) continue;

            uint hash = CalculateHashFromGrid(gridPosJ);

            uint startIndex = Offsets[hash];
            uint endIndex = Offsets[hash + 1];

            for (uint j = startIndex; j < endIndex; j++) {
                if (i == j) continue;

                float massOverDensity = particleMass / Densities[j];
                float2 offset = Positions[i] - Positions[j];

                viscosity += CalculateViscosityContribution(i, j);
                surfaceTension += CalculateSurfaceTensionContribution(i, j);
            }
        }
    }
}

float2 CalculateAcceleration(uint i) {
    float2 viscosity, surfaceTension;

    CalculateComponents(i, viscosity, surfaceTension);

    return MouseForce(i) + gravity + viscosity + surfaceTension;
}

[numthreads(NumThreads, 1, 1)]
void ZeroCounts(uint id : SV_DispatchThreadID) {
    if (id.x >= tableSize) return;

    CellCounts[id.x] = 0;
    LocalOffsets[id.x] = 0;
}

[numthreads(NumThreads, 1, 1)]
void Partition(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;
    IndexAndCount(id.x);
}

[numthreads(NumThreads, 1, 1)]
void Scan(uint3 id : SV_GroupThreadID, uint3 groupId : SV_GroupID) {
    PrefixScan(id.x, groupId.x);
}

[numthreads(NumThreads, 1, 1)]
void ScanBlockSums(uint3 id : SV_GroupThreadID) {
    ScanBlockSums(id.x, numBlockSums);
}

[numthreads(NumThreads, 1, 1)]
void AddBlockSums(uint3 id : SV_DispatchThreadID) {
    AddBlockSums(id.x);
}

[numthreads(1, 1, 1)]
void FinalizeScan(uint3 id : SV_DispatchThreadID) {
    Offsets[tableSize] = instanceCount;
}

[numthreads(NumThreads, 1, 1)]
void Scatter(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    SortParticle(id.x);
}

[numthreads(NumThreads, 1, 1)]
void IntermediateAcceleration(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    IntermediateAccelerations[id.x] = CalculateAcceleration(id.x);
}

[numthreads(NumThreads, 1, 1)]
void Density(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    float2 densities = CalculateDensities(id.x);

    Densities[id.x] = densities.x;
    NearDensities[id.x] = densities.y;
}

[numthreads(NumThreads, 1, 1)]
void UpdateVelocities(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    float2 acceleration = CalculateAcceleration(id.x);
    float2 xsphCorrection = CalculateXSPHCorrection(id.x);

    Velocities[id.x] += acceleration * deltaTime + xsphCorrection;
}

[numthreads(NumThreads, 1, 1)]
void UpdatePositions(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    Positions[id.x] += Velocities[id.x] * deltaTime;

    Collisions(id.x);
}