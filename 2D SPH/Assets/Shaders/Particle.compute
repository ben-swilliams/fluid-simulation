#pragma kernel ClearCounts
#pragma kernel Partition
#pragma kernel Scan
#pragma kernel ScanBlockSums
#pragma kernel AddBlockSums
#pragma kernel FinalizeScan
#pragma kernel Scatter
#pragma kernel CalculateDensity
#pragma kernel CalculateNonPressureAcceleration
#pragma kernel PredictVelocityAndCalculateD
#pragma kernel PredictDensityAndCalculateA
#pragma kernel CalculatePressureSums
#pragma kernel CalculateNextPressure
#pragma kernel FinalisePressureIteration

#pragma kernel UpdateVelocities
#pragma kernel UpdatePositions

/*
Global parameters
*/

static const uint NumThreads = 64;

// Integer buffers
RWStructuredBuffer<uint> CellCounts;
RWStructuredBuffer<uint> Offsets;
RWStructuredBuffer<uint> LocalOffsets;

// Float buffers
RWStructuredBuffer<float> Densities;
RWStructuredBuffer<float> Aii;
RWStructuredBuffer<float> IterPressures;
RWStructuredBuffer<float> Pressures;

// Vector buffers
RWStructuredBuffer<float3> Positions;
RWStructuredBuffer<float3> Velocities;

RWStructuredBuffer<float3> IntermediateAccelerations;
RWStructuredBuffer<float3> Dii;
RWStructuredBuffer<float3> DPSum;


// Integers
uint instanceCount;

// Floats
float deltaTime;
float particleMass;
float smoothingRadius;
float maxVelocity;

// Vectors
float3 containerSize;

/*
External force parameters
*/
// Floats
float size;
float dampingFactor;
float power;
float mouseRadius;

// Vectors
float3 mousePos;
float3 gravity;

/*
Scan/partition parameters
*/
// Integers
uint tableSize;
uint numBlockSums;

#include "Kernels.hlsl"
#include "Partition.hlsl"
#include "Scan.hlsl"
#include "Scatter.hlsl"
#include "External.hlsl"
#include "IISPH.hlsl"
#include "Density.hlsl"
#include "Pressure.hlsl"
#include "Viscosity.hlsl"
#include "SurfaceTension.hlsl"
#include "XSPH.hlsl"

void CalculateComponents(uint i, out float3 viscosity, out float3 surfaceTension) {
    int3 gridPosI = GetGridPos(Positions[i]);

    for (int x = -1; x < 2; x++) {
        for (int y = -1; y < 2; y++) {
            for (int z = -1; z < 2; z++) {
                int3 gridPosJ = gridPosI + int3(x, y, z);
                if (!IsInBounds(gridPosJ)) continue;

                uint hash = CalculateHashFromGrid(gridPosJ);

                uint startIndex = Offsets[hash];
                uint endIndex = Offsets[hash + 1];

                for (uint j = startIndex; j < endIndex; j++) {
                    if (i == j) continue;

                    float massOverDensity = particleMass / Densities[j];
                    float3 offset = Positions[i] - Positions[j];

                    viscosity += CalculateViscosityContribution(i, j);
                    surfaceTension += CalculateSurfaceTensionContribution(i, j);
                }
            }
        }
    }
}

float2 CalculateAcceleration(uint i) {
    float2 viscosity, surfaceTension;

    CalculateComponents(i, viscosity, surfaceTension);

    return MouseForce(i) + gravity + viscosity + surfaceTension;
}

[numthreads(NumThreads, 1, 1)]
void ClearCounts(uint id : SV_DispatchThreadID) {
    if (id.x >= tableSize) return;

    CellCounts[id.x] = 0;
    LocalOffsets[id.x] = 0;
}

[numthreads(NumThreads, 1, 1)]
void Partition(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;
    IndexAndCount(id.x);
}

[numthreads(NumThreads, 1, 1)]
void Scan(uint3 id : SV_GroupThreadID, uint3 groupId : SV_GroupID) {
    PrefixScan(id.x, groupId.x);
}

[numthreads(NumThreads, 1, 1)]
void ScanBlockSums(uint3 id : SV_GroupThreadID) {
    ScanBlockSums(id.x, numBlockSums);
}

[numthreads(NumThreads, 1, 1)]
void AddBlockSums(uint3 id : SV_DispatchThreadID) {
    AddBlockSums(id.x);
}

[numthreads(1, 1, 1)]
void FinalizeScan(uint3 id : SV_DispatchThreadID) {
    Offsets[tableSize] = instanceCount;
}

[numthreads(NumThreads, 1, 1)]
void Scatter(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    SortParticle(id.x);
}

[numthreads(NumThreads, 1, 1)]
void CalculateDensity(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    Densities[id.x] = CalculateDensity(id.x);
}

[numthreads(NumThreads, 1, 1)]
void CalculateNonPressureAcceleration(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    IntermediateAccelerations[id.x] = CalculateAcceleration(id.x);
}

[numthreads(NumThreads, 1, 1)]
void PredictVelocityAndCalculateD(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    Velocities[id.x] += IntermediateAccelerations[id.x] * deltaTime;
    Dii[id.x] = CalculateD(id.x);
}

[numthreads(NumThreads, 1, 1)]
void PredictDensityAndCalculateA(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    float3 values = CalculateDeltaDensityAndA(id.x);
    float deltaDensity = values.x;
    float a = values.y;

    Densities[instanceCount + id.x] = Densities[id.x] + deltaDensity * deltaTime;
    Aii[id.x] = a;
}

[numthreads(NumThreads, 1, 1)]
void CalculatePressureSums(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    DPSum[id.x] = CalculatePressureSum(id.x);
}

[numthreads(NumThreads, 1, 1)]
void CalculateNextPressure(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    Pressures[id.x] = CalculateNextPressureValue(id.x);
}

[numthreads(NumThreads, 1, 1)]
void FinalisePressureIteration(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    IterPressures[id.x] = Pressures[id.x];
}

[numthreads(NumThreads, 1, 1)]
void UpdateVelocities(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    float3 xsphCorrection = CalculateXSPHCorrection(id.x);

    Velocities[id.x] += CalculatePressureForce(id.x) * deltaTime / particleMass + xsphCorrection;
    float mag = length(Velocities[id.x]);
    if (mag > maxVelocity) {
        Velocities[id.x] = maxVelocity * Velocities[id.x] / mag;
    }
}

[numthreads(NumThreads, 1, 1)]
void UpdatePositions(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    Positions[id.x] += Velocities[id.x] * deltaTime;

    Collisions(id.x);
}