#pragma kernel CalculateDensity

#pragma kernel WriteDensities

#pragma kernel CalculateVelocityColour
#pragma kernel CalculateDensityColour
#pragma kernel CalculatePressureColour

/*
Global parameters
*/

// Float buffers

// Vector buffers


RWStructuredBuffer<float3> Colours;

RWTexture3D<float> DensityTex;
int3 densityTexDims;

#include "Common.hlsl"
#include "Partition.hlsl"
#include "Kernels.hlsl"
#include "External.hlsl"
#include "Density.hlsl"
#include "Pressure.hlsl"
#include "Viscosity.hlsl"
#include "Colours.hlsl"

/*
SPATIAL HASHING
*/

[numthreads(NumThreads, 1, 1)]
void CalculateDensity(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    float2 densities = CalculateDensities(id.x);

    Densities[3 * id.x] = max(densities.x, Epsilon);
    Densities[3 * id.x + 1] = max(densities.y, Epsilon);
}

[numthreads(NumThreads, 1, 1)]
void UpdatePositions(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    Positions[id.x] += Velocities[id.x] * deltaTime;

    Collisions(id.x);
}

[numthreads(8, 8, 8)]
void WriteDensities(uint3 id : SV_DispatchThreadID) {
    if (id.x >= densityTexDims.x || id.y >= densityTexDims.y || id.z >= densityTexDims.z) return;

    float3 texPos = id / (densityTexDims - 1.0);
    float3 pos = (texPos - 0.5) * containerSize;

    DensityTex[id] = CalculateDensityAtWorld(pos);
}

// TODO: Extract these into their own .compute file
[numthreads(NumThreads, 1, 1)]
void CalculateVelocityColour(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    Colours[id.x] = ColourFromVelocity(id.x);
}

[numthreads(NumThreads, 1, 1)]
void CalculatePressureColour(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    Colours[id.x] = ColourFromPressure(id.x);
}

[numthreads(NumThreads, 1, 1)]
void CalculateDensityColour(uint3 id : SV_DispatchThreadID) {
    if (id.x >= instanceCount) return;

    Colours[id.x] = ColourFromDensity(id.x);
}